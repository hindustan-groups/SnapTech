# ── Vite Client Environment Variables ──────────────────────────
# Copy this file to .env.local for local development
# Set these in your hosting dashboard (Vercel / Netlify) for production

# ── Backend API URL ─────────────────────────────────────────────
# Local dev: leave empty — Vite proxy forwards /api → localhost:5000
# Production: your deployed backend URL (Render / Railway / VPS)
VITE_API_URL=https://api.snaptech.digital/api

# ── Google reCAPTCHA v3 Site Key (safe to expose) ───────────────
# Get from: https://www.google.com/recaptcha/admin
# Must use "Score based (v3)" type
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
