# ── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=https://www.snaptech.digital

# ── Database (PostgreSQL via Neon / Supabase / Railway) ─────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/snaptech_digital?schema=public"

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_64_chars
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=info@snaptech.digital
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="SnapTech Digital <info@snaptech.digital>"

# ── Resend (Recommended - replaces SMTP if set) ─────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# ── Google reCAPTCHA v3 ─────────────────────────────────────────
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key

# ── Cloudinary (Image Storage) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Admin Seed Credentials ───────────────────────────────────────
SEED_ADMIN_EMAIL=admin@snaptech.digital
SEED_ADMIN_PASSWORD=ChangeMe@123_SetStrongPasswordInProduction

# ── Admin Secret Path ────────────────────────────────────────────
ADMIN_SECRET_PATH=change_this_secret_path

# ── Integration Page Master Key ─────────────────────────────────
INTEGRATION_MASTER_KEY=your_strong_integration_master_key
